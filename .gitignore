# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp
/tmp/

# Local packaging and one-off backups
/dist/
/.cleanup-backup-*/
/.git-backup-*.zip
/atlas*.zip

# Log files
*.log

# Browser profiles created while rendering analysis outputs
/analysis/output/edge-render-*/

# Build artifacts and directories
**/build/
build/
*.o
*.a
*.out
# Host-side utilities compiled on Windows
*.exe

# ESP-IDF specific build outputs
*.bin
*.elf
*.map
# Generated in the ESP-IDF build directory
flasher_args.json
sdkconfig.old
sdkconfig

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
.pytest_cache/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# User-specific configuration files
*.user
*.workspace # General workspace files, can be from various tools
*.suo       # Visual Studio Solution User Options
*.sln.docstates # Visual Studio
